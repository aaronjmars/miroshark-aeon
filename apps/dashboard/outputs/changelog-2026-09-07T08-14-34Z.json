        "variant": "body"
      }
    },
    "separator_2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "link_section": {
      "type": "Link",
      "props": {
        "label": "PR: aaronjmars/miroshark-website#314",
