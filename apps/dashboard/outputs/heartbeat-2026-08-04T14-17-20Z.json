      }
    },
    "separator_1": {
      "type": "Separator",
      "props": {}
    },
    "section_skills": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "heading_skills",
        "skills_grid"
      ]
    },
    "heading_skills": {
      "type": "Heading",
      "props": {
        "text": "Affected Skills (7)",
        "level": "h3"
      }
    },
    "skills_grid": {
      "type": "Grid",
      "props": {
        "columns": 4,
        "gap": "sm"
      },
      "children": [
        "skill_1",
        "skill_2",
        "skill_3",
        "skill_4",
        "skill_5",
        "skill_6",
        "skill_7"
      ]
    },
    "skill_1": {
      "type": "Badge",
      "props": {
