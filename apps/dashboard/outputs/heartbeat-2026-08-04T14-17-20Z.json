    "skill_3": {
      "type": "Badge",
      "props": {
        "text": "shiplog",
        "variant": "destructive"
      }
    },
    "skill_4": {
      "type": "Badge",
      "props": {
        "text": "token-movers",
        "variant": "destructive"
      }
    },
    "skill_5": {
      "type": "Badge",
      "props": {
        "text": "fetch-tweets",
        "variant": "destructive"
      }
    },
    "skill_6": {
      "type": "Badge",
      "props": {
        "text": "changelog",
        "variant": "destructive"
      }
    },
    "skill_7": {
      "type": "Badge",
      "props": {
        "text": "holdings",
        "variant": "destructive"
      }
    },
    "separator_2": {
      "type": "Separator",
      "props": {}
    },
    "section_details": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "heading_details",
        "detail_1",
        "detail_2",
        "detail_3",
        "detail_4",
        "detail_5"
      ]
    },
    "heading_details": {
      "type": "Heading",
      "props": {
        "text": "Investigation Summary",
        "level": "h3"
      }
    },
    "detail_1": {
      "type": "Text",
      "props": {
        "text": "Each skill shows fresh dispatch (08-02/08-03) but last_success stuck days earlier.",
        "variant": "body"
      }
    },
    "detail_2": {
      "type": "Text",
      "props": {
        "text": "Success rates remain 100% historically, indicating this is not per-skill bugs.",
        "variant": "body"
      }
    },
    "detail_3": {
      "type": "Text",
      "props": {
        "text": "Root cause hypothesis: outcome-write step or scheduler's git commit-back broke fleet-wide.",
        "variant": "body"
      }
    },
    "detail_4": {
      "type": "Text",
      "props": {
        "text": "No memory/logs/ file has been written since 2026-07-30, confirming nothing has actually completed.",
        "variant": "body"
      }
    },
    "detail_5": {
      "type": "Text",
      "props": {
        "text": "docs/status.md updated to 🔴 DEGRADED.",
        "variant": "body"
      }
    },
