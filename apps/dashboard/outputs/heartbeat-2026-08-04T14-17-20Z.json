{
  "root": "card_main",
  "state": {},
  "elements": {
    "card_main": {
      "type": "Card",
      "props": {
        "title": "Heartbeat: Fleet Stuck",
        "description": "Fleet-wide dispatch failure across 7 core skills"
      },
      "children": [
        "alert_main",
        "separator_1",
        "section_skills",
        "separator_2",
        "section_details",
        "separator_3",
        "section_heartbeat",
        "separator_4",
        "section_health",
        "separator_5",
        "section_actions"
      ]
    },
    "alert_main": {
      "type": "Alert",
      "props": {
        "title": "🔴 FLEET STUCK",
        "message": "7/8 enabled skills dispatched but never completed since ~2026-07-30/31 (5+ days): repo-pulse, memory-flush, shiplog, token-movers, fetch-tweets, changelog, holdings.",
