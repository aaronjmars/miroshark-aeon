    "hb_status_1": {
      "type": "Stat",
      "props": {
        "label": "Last Success",
        "value": "2026-07-30T19:18 UTC",
        "delta": "~4 days stale",
        "trend": "down"
      }
    },
    "hb_status_2": {
      "type": "Text",
      "props": {
        "text": "08-03 19:00 UTC scheduled dispatch is missing from cron-state.json entirely.",
        "variant": "body"
      }
    },
    "separator_4": {
      "type": "Separator",
      "props": {}
    },
    "section_health": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "heading_health",
        "health_1",
        "health_2",
        "health_3"
      ]
    },
    "heading_health": {
      "type": "Heading",
      "props": {
        "text": "🔵 Health Status",
        "level": "h3"
      }
    },
    "health_1": {
      "type": "Text",
      "props": {
        "text": "P1/P2 clean — 0 open PRs",
        "variant": "body"
      }
    },
    "health_2": {
      "type": "Text",
      "props": {
        "text": "Issue #117 (fetch-tweets health) open but not urgent",
        "variant": "body"
      }
    },
    "health_3": {
      "type": "Text",
      "props": {
        "text": "Nothing new flagged in memory",
        "variant": "body"
      }
    },
    "separator_5": {
      "type": "Separator",
      "props": {}
    },
    "section_actions": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "heading_actions",
        "action_1",
        "action_2"
      ]
    },
    "heading_actions": {
      "type": "Heading",
      "props": {
        "text": "Recommended Next Steps",
        "level": "h3"
      }
    },
    "action_1": {
      "type": "Text",
      "props": {
        "text": "Check the GitHub Actions run history directly — the scheduler workflow itself may need investigation.",
        "variant": "body"
      }
    },
    "action_2": {
      "type": "Text",
      "props": {
        "text": "Investigate outcome-write step and scheduler's git commit-back process — likely cause of fleet-wide breakage.",
        "variant": "body"
      }
    }
  }
